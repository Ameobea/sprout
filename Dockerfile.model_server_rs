# Rust inference engine for the anime recommendation model.
#
# Build: docker build -f Dockerfile.model_server_rs -t anime-model-server-rs .
# Run:   docker run --net host -e PORT=5708 anime-model-server-rs
#
# NOTE: built with -C target-cpu=znver4 (see model-server-rs/.cargo/config.toml);
# the binary requires an AVX-512 Zen 4+ CPU (EPYC 4344P prod box, 7950X dev box).

FROM rustlang/rust:nightly-slim AS build
WORKDIR /src
COPY model-server-rs/Cargo.toml model-server-rs/Cargo.lock ./
COPY model-server-rs/.cargo .cargo
COPY model-server-rs/src src
RUN cargo build --release --bin serve

FROM debian:bookworm-slim
COPY --from=build /src/target/release/serve /usr/local/bin/model-server
COPY model-server-rs/deploy/models.json /opt/model/models.json
COPY data/aug2026/jax_model_fresh_logq.msgpack /opt/model/2026-logq/weights.msgpack
COPY data/corpus_ids_aug2026.json /opt/model/2026-logq/corpus_ids.json
COPY data/processed-metadata_aug2026.csv /opt/model/2026-logq/processed-metadata.csv
COPY data/aug2026/train_counts_2026logq.json /opt/model/2026-logq/train_counts.json
COPY data/aug2026/rc_full_seed0.msgpack /opt/model/2026-rc/weights.msgpack
COPY data/corpus_ids_aug2026.json /opt/model/2026-rc/corpus_ids.json
COPY data/processed-metadata_aug2026.csv /opt/model/2026-rc/processed-metadata.csv
COPY data/aug2026/train_counts_2026logq.json /opt/model/2026-rc/train_counts.json
COPY data/aug2026/serve/ease_B6k_lam200.f32bin /opt/model/shared/ease_B.f32bin
COPY data/aug2026/serve/ease_mu6k.f32bin /opt/model/shared/ease_mu.f32bin
COPY data/aug2026/serve/rating_resid_B6k.f32bin /opt/model/shared/rating_resid_B.f32bin
COPY data/aug2026/serve/rating_imean6k.f32bin /opt/model/shared/rating_imean.f32bin
COPY data/jax_model_dec2025.msgpack /opt/model/2025-jax/weights.msgpack
COPY data/corpus_ids-dec2025.json /opt/model/2025-jax/corpus_ids.json
COPY data/processed-metadata-dec2025.csv /opt/model/2025-jax/processed-metadata.csv

ENV MODELS_CONFIG=/opt/model/models.json
ENV PORT=8000
ENV METRICS_PORT=5709
ENV INFER_THREADS=8
ENV PIN_CORES=1
ENV PRECISION=bf16

EXPOSE 8000 5709
CMD ["model-server"]
